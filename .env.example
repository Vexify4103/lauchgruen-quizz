# Twitch OAuth — register an app at https://dev.twitch.tv/console/apps
# Redirect URL (dev): http://localhost:3001/api/auth/callback/twitch
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Auth.js
# Generate: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3001
NEXTAUTH_URL=http://localhost:3001

# Server
PORT=3001
HOSTNAME=localhost

# LiveKit SFU
# Local dev with docker-compose.livekit.yml:
# NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
# Production:
# NEXT_PUBLIC_LIVEKIT_URL=wss://livekit.lauchgruen.de
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Optional locally; required for restart-safe game state in production.
# Dedicated collection: lauchgruen_quizz_game_state
MONGODB_URI=
MONGODB_DB=lauchgruen
