TWITCH_CLIENT_ID=CHANGE_ME
TWITCH_CLIENT_SECRET=CHANGE_ME

# Generate with: openssl rand -base64 32
AUTH_SECRET=CHANGE_ME
AUTH_URL=https://quiz.lauchgruen.de
NEXTAUTH_URL=https://quiz.lauchgruen.de

NEXT_PUBLIC_LIVEKIT_URL=wss://livekit.lauchgruen.de
LIVEKIT_API_KEY=quizduell
LIVEKIT_API_SECRET=CHANGE_ME_LIVEKIT_SECRET

# Persistent game state (dedicated collection: lauchgruen_quizz_game_state)
MONGODB_URI=CHANGE_ME
MONGODB_DB=lauchgruen_quizz

PORT=3000
HOSTNAME=0.0.0.0

# Host ports exposed by docker-compose.yml
QUIZ_PORT=3000
LIVEKIT_HTTP_PORT=7880
LIVEKIT_TCP_PORT=7881
LIVEKIT_UDP_PORT_START=50000
LIVEKIT_UDP_PORT_END=60000
